{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "model": "agentworks/glm-5-3",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "circleci-mcp-server": {
      "type": "local",
      "command": ["npx", "-y", "@circleci/mcp-server-circleci"],
      "environment": {
        "CIRCLECI_TOKEN": "<your-circleci-token>"
      }
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  },
  "provider": {
    "agentworks": {
      "name": "AgentWorks",
      "api": "https://openai.com/v1",
      "options": {
        "apiKey": "<your-openai-api-key>",
        "baseURL": "https://api.thoughtworks.polis.thoughtworks-labs.net/v1/inference"
      },
      "models": {
        "deepseek-v4-flash": {
          "id": "agentworks/deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "tool_call": true,
          "limit": { "context": 1048576, "output": 8192 },
          "cost": { "input": 0.14, "output": 0.28 }
        },
        "deepseek-v4-pro": {
          "id": "agentworks/deepseek-v4-pro",
          "name": "DeepSeek V4 Pro",
          "tool_call": true,
          "limit": { "context": 1048576, "output": 8192 },
          "cost": { "input": 1.74, "output": 3.48 }
        },
        "glm-5-3": {
          "id": "agentworks/glm-5-3",
          "name": "GLM 5.3",
          "tool_call": true,
          "limit": { "context": 262144, "output": 8192 },
          "cost": { "input": 1.4, "output": 4.4 }
        }
      }
    }
  }
}
